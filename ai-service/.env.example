# Required. Use the same per-environment random value as AI_SERVICE_TOKEN in backend/.env (32+ bytes).
AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes

# Optional LLM enhancement. Default "none" keeps the service fully offline.
# Values: none | anthropic | openai_compatible. Only de-identified text is ever sent.
LLM_PROVIDER=none
# Required whenever LLM_PROVIDER is not none (the service refuses to start without it).
LLM_MODEL=
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# For openai_compatible, e.g. a local server: http://localhost:11434/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=20

# Parsing
PARSE_WORKERS=2
PARSE_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=10485760
# OCR for scanned resumes needs requirements-ocr.txt.
OCR_ENABLED=false
# LibreOffice binary for .doc conversion; auto-detected on PATH when unset, an empty value disables it.
# SOFFICE_PATH=
# Extra taxonomy file, e.g. the output of `python -m app.taxonomy.import_esco`.
# TAXONOMY_EXTRA_PATH=
