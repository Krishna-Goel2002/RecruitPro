# ===================================================
# AI-Powered Recruitment Platform - Environment Variables
# Copy this file to .env and adjust values for your environment.
# DO NOT commit real secrets or passwords to Git.
# ===================================================

# ---- Spring Profile & Server ----
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ---- Database Configuration (MySQL) ----
DB_URL=jdbc:mysql://localhost:3307/recruitment_platform_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# ---- Security & Authentication ----
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# ---- AI Microservice URL ----
AI_SERVICE_URL=http://localhost:8000

# ---- File Storage ----
FILE_STORAGE_PATH=./uploads

# ---- CORS Allowed Origins ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
