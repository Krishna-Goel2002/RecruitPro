# ===================================================
# RecruitPro - Docker Compose overrides
# Copy to .env next to docker-compose.yml. Every value has a development default in
# docker-compose.yml; set real secrets for anything other than local development.
# DO NOT commit real secrets.
# ===================================================

# Signing key for access tokens (at least 32 random bytes), e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Shared secret between the backend and the AI service (X-Internal-Service-Token)
AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes

# Optional LLM enhancement in the AI service (none | anthropic | openai_compatible)
LLM_PROVIDER=none

# Shared secret between the backend and the agent service (X-Internal-Service-Token)
AGENT_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes
# Optional LLM summary in the agent service (none | anthropic | openai_compatible); verdicts never depend on it
AGENT_LLM_PROVIDER=none
# Synthetic offline fixtures for demo- logins/hosts (local demos only; set false anywhere else)
AGENT_DEMO_FIXTURES=true

# AES-256-GCM key (32 random bytes, Base64) for connector tokens and MFA secrets: `openssl rand -base64 32`.
# docker-compose.yml has a DEV-ONLY default; always set a real key outside local development.
APP_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Optional GitHub OAuth app for "Connect with GitHub" (scope read:user). Callback URL to register:
# http://localhost:8080/api/v1/verification/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/verification/oauth/github/callback

# Demo data: organisation "Acme Labs", demo accounts and two published jobs
APP_SEED_DEMO=true
APP_SEED_PASSWORD=ChangeMe-123!

# First organisation + administrator, created once when no organisation exists
# (leave empty to use self-service sign-up at http://localhost:5174/signup instead)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
