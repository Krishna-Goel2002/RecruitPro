# ===================================================
# RecruitPro - Docker Compose overrides
# Copy to .env next to docker-compose.yml. Every value has a development default in
# docker-compose.yml; set real secrets for anything other than local development.
# DO NOT commit real secrets.
# ===================================================

# Signing key for access tokens (at least 32 random bytes), e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Shared secret between the backend and the AI service (X-Internal-Service-Token)
AI_SERVICE_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes

# Optional LLM enhancement in the AI service (none | anthropic | openai_compatible)
LLM_PROVIDER=none

# Demo data: organisation "Acme Labs", demo accounts and two published jobs
APP_SEED_DEMO=true
APP_SEED_PASSWORD=ChangeMe-123!

# First organisation + administrator, created once when no organisation exists
# (leave empty to use self-service sign-up at http://localhost:5174/signup instead)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
