# ===================================================
# RecruitPro - Docker Compose overrides
# Create your .env with fresh random secrets (never copy secrets from anywhere):
#     python tools/generate_env.py        (Windows without Python: .\tools\generate-env.ps1)
# It copies this file to .env and fills JWT_SECRET, AI_SERVICE_TOKEN, AGENT_SERVICE_TOKEN and APP_ENCRYPTION_KEY.
# docker-compose.yml has no default secrets; the backend refuses any value that was ever published.
# .env is git-ignored. DO NOT commit it.
# ===================================================

# ---- One address for the whole product (service `gateway`) ----
# http://localhost:8088 serves the landing site (/), the candidate portal (/candidate/), the HR portal (/hr/) and the
# API (/api/v1). Not port 80: on Windows it is often taken or reserved (IIS, the HTTP.sys "System" process, excluded
# port ranges: `netsh interface ipv4 show excludedportrange protocol=tcp`). 127.0.0.1 only by default; 0.0.0.0 shows it
# on your network (then PUBLIC_URL must be an address other devices can reach).
GATEWAY_PORT=8088
GATEWAY_BIND=127.0.0.1
# The gateway's address as the browser sees it: links in e-mails go to <PUBLIC_URL>/candidate/... and <PUBLIC_URL>/hr/...
# Change it together with GATEWAY_PORT (and SSO_REDIRECT_BASE_URL / GITHUB_OAUTH_REDIRECT_URI below).
PUBLIC_URL=http://localhost:8088

# Signing key for access tokens (at least 32 random bytes), e.g. `openssl rand -base64 48`.
# Left empty here on purpose: tools/generate_env.py (or tools/generate-env.ps1) fills it in your .env.
JWT_SECRET=

# Shared secret between the backend and the AI service (X-Internal-Service-Token). Filled by tools/generate_env.py.
AI_SERVICE_TOKEN=

# Optional LLM enhancement in the AI service (none | anthropic | openai_compatible). The AI service has no internet
# access in compose; with a provider, start with: docker compose -f docker-compose.yml -f docker-compose.ai-egress.yml up -d
# To make every later `docker compose ...` command include the override (otherwise a plain `docker compose up -d`
# recreates the AI service without egress), uncomment ONE of these (the list separator is ":" on Linux/macOS, ";" on Windows):
# COMPOSE_FILE=docker-compose.yml:docker-compose.ai-egress.yml
# COMPOSE_FILE=docker-compose.yml;docker-compose.ai-egress.yml
LLM_PROVIDER=none
# Needed only when a provider other than none is chosen (AI service and, with AGENT_LLM_PROVIDER, the agent service)
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# HR assistant planner in the AI service: none (offline rules, the default) | gemini | groq | anthropic | openai_compatible.
# A provider needs ASSISTANT_LLM_MODEL (no default on purpose: model names change, check the provider's model list),
# its key below (anthropic/openai_compatible reuse the keys above) and the ai-egress override. The organisation's
# "assistant external model" setting must also allow it; any LLM failure falls back to the offline planner.
ASSISTANT_LLM_PROVIDER=none
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_TIMEOUT_SECONDS=20
ASSISTANT_MAX_OUTPUT_TOKENS=1024
GEMINI_API_KEY=
# Optional override (default https://generativelanguage.googleapis.com/v1beta/openai/)
GEMINI_BASE_URL=
GROQ_API_KEY=
# Optional override (default https://api.groq.com/openai/v1)
GROQ_BASE_URL=

# OCR for scanned resumes in the AI service (RapidOCR is installed in the image; off unless true)
OCR_ENABLED=false

# Shared secret between the backend and the agent service (X-Internal-Service-Token)
# Filled by tools/generate_env.py (the backend and the agent service read the same value).
AGENT_SERVICE_TOKEN=
# Optional LLM summary in the agent service (none | anthropic | openai_compatible); verdicts never depend on it
AGENT_LLM_PROVIDER=none
# Synthetic offline fixtures for demo- logins/hosts (local demos only; set false anywhere else)
AGENT_DEMO_FIXTURES=true

# AES-256-GCM key (32 random bytes, Base64) for connector tokens, MFA secrets and SSO: `openssl rand -base64 32`.
# Filled by tools/generate_env.py. A value that is not Base64 of exactly 32 bytes stops the backend from starting.
APP_ENCRYPTION_KEY=

# Optional GitHub OAuth app for "Connect with GitHub" (scope read:user). The app's "Authorization callback URL" on
# github.com (Settings > Developer settings > OAuth Apps) must be EXACTLY the value below - the gateway origin:
#   http://localhost:8088/api/v1/verification/oauth/github/callback
# Old per-port mode (backend called directly on 8080) instead:
#   http://localhost:8080/api/v1/verification/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8088/api/v1/verification/oauth/github/callback

# Demo data: organisation "Acme Labs", demo accounts and two published jobs
APP_SEED_DEMO=true
APP_SEED_PASSWORD=ChangeMe-123!

# First organisation + administrator, created once when no organisation exists
# (leave empty to use self-service sign-up at http://localhost:8088/hr/signup instead)
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional GitHub API token for the agent service (rate limits on real, non-demo accounts)
AGENT_GITHUB_TOKEN=

# Optional staff single sign-on (OIDC). Register <SSO_REDIRECT_BASE_URL>/api/v1/auth/sso/<google|microsoft|oidc>/callback
# with the identity provider; a provider is offered only when its client id and secret are set. Staff must also be
# listed by domain in the HR portal: Administration > Organisation > Single sign-on: allowed e-mail domains.
# Gateway origin by default; per-port mode: http://localhost:8080
SSO_REDIRECT_BASE_URL=http://localhost:8088
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT_ID=organizations
SSO_OIDC_NAME=Company SSO
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_ISSUER=
