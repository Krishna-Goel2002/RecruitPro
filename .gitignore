# ===========================
# Root .gitignore
# AI-Powered Recruitment Platform
# ===========================

# === IDE ===
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Java / Maven Backend ===
backend/target/
backend/*.jar
backend/*.war
backend/*.class
backend/.mvn/wrapper/maven-wrapper.jar
backend/logs/
backend/uploads/

# === Node / React Frontend ===
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# === Python AI Service ===
**/__pycache__/
*.py[cod]
ai-service/__pycache__/
ai-service/*.pyc
ai-service/*.pyo
ai-service/.venv/
ai-service/venv/
ai-service/env/
ai-service/*.egg-info/
ai-service/dist/
ai-service/build/
ai-service/.mypy_cache/
ai-service/.pytest_cache/

# === Environment Files ===
.env
.env.local
.env.*.local

# === Logs ===
*.log
logs/

# === Local-only isolated integration-test launcher and storage ===
/test-data/scripts/Start-RecruitProMigrationTest.ps1
test-data/resume-storage-*/

# === Docker (future) ===
docker-compose.override.yml
