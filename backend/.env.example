# ===================================================
# RecruitPro backend - environment variables for running the jar or `mvnw spring-boot:run`
# Spring Boot does not read this file by itself: export the variables in your shell or
# configure them in your IDE run configuration. DO NOT commit real secrets.
# ===================================================

# ---- Profile & server ----
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ---- Database (PostgreSQL 16; the dev profile defaults to these values) ----
DB_URL=jdbc:postgresql://localhost:5432/recruitpro
DB_USERNAME=recruitpro
DB_PASSWORD=recruitpro

# ---- Security ----
# Access-token signing key, at least 32 random bytes (required in every profile)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Refresh cookie Secure flag (dev defaults to false for http://localhost; prod is always true)
AUTH_COOKIE_SECURE=false
# Candidates must verify their email before applying (dev default false, prod default true)
AUTH_REQUIRE_VERIFIED_EMAIL_TO_APPLY=false
# Per-IP rate limits on /api/v1/auth/** and organisation sign-up
RATE_LIMIT_ENABLED=true
# Allow POST /api/v1/organizations/signup
ORG_SELF_SIGNUP_ENABLED=true
# API clients and tests only: also return/accept the refresh token in the JSON body (browsers use the cookies
# rp_refresh_candidate / rp_refresh_staff, chosen by the X-RecruitPro-Portal header; rp_refresh without it)
AUTH_EXPOSE_REFRESH_TOKEN_IN_BODY=false

# ---- Portals (CORS and links in emails) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CANDIDATE_PORTAL_URL=http://localhost:5173
HR_PORTAL_URL=http://localhost:5174

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-used-by-ai-service
BACKGROUND_JOBS_ENABLED=true
# Scheduled tasks: close PUBLISHED jobs past their deadline; expire overdue work samples; send the mail outbox
JOB_DEADLINE_CLOSER_ENABLED=true
WORK_SAMPLE_EXPIRY_SWEEP_ENABLED=true
NOTIFICATIONS_SENDER_ENABLED=true

# ---- Resume storage ----
FILE_STORAGE_PATH=./uploads

# ---- Email (Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) ----
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=RecruitPro <no-reply@recruitpro.local>
# dev: log verification/reset/invitation links (with tokens) when MAIL_ENABLED=false
NOTIFICATIONS_LOG_LINKS=true
# dev: return the invitation link in POST /api/v1/admin/invitations
INVITATIONS_EXPOSE_LINK=true

# ---- First organisation (created once when none exists) ----
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Organisation
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# ---- Demo data (never in prod) ----
APP_SEED_DEMO=false
APP_SEED_PASSWORD=ChangeMe-123!
