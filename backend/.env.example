# ===================================================
# RecruitPro backend - environment variables for running the jar or `mvnw spring-boot:run`
# Spring Boot does not read this file by itself: export the variables in your shell or
# configure them in your IDE run configuration. DO NOT commit real secrets.
# ===================================================

# ---- Profile & server ----
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# ---- Database (PostgreSQL 16; the dev profile defaults to these values) ----
DB_URL=jdbc:postgresql://localhost:5432/recruitpro
DB_USERNAME=recruitpro
DB_PASSWORD=recruitpro

# ---- Security ----
# Access-token signing key, at least 32 random bytes (required in every profile)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Absolute session lifetime in days: a sign-in ends after this however often its refresh token rotates (default 30).
JWT_REFRESH_ABSOLUTE_LIFETIME_DAYS=30
# Refresh cookie Secure flag (dev defaults to false for http://localhost; prod is always true)
AUTH_COOKIE_SECURE=false
# Candidates must verify their email before applying (dev default false, prod default true)
AUTH_REQUIRE_VERIFIED_EMAIL_TO_APPLY=false
# Per-IP rate limits on /api/v1/auth/** and organisation sign-up
RATE_LIMIT_ENABLED=true
# Allow POST /api/v1/organizations/signup
ORG_SELF_SIGNUP_ENABLED=true
# API clients and tests only: also return/accept the refresh token in the JSON body (browsers use the cookies
# rp_refresh_candidate / rp_refresh_staff, chosen by the X-RecruitPro-Portal header; rp_refresh without it)
AUTH_EXPOSE_REFRESH_TOKEN_IN_BODY=false

# ---- Portals (CORS and links in emails) ----
# `pnpm dev` serves the portals under /candidate/ and /hr/ and proxies /api to this backend (same origin, so CORS is
# only needed for the per-port mode). Behind the gateway (docker compose): http://localhost:8088/candidate and /hr.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8088
CANDIDATE_PORTAL_URL=http://localhost:5173/candidate
HR_PORTAL_URL=http://localhost:5174/hr

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-the-same-random-secret-used-by-ai-service
# Read time-out for resume parsing in ms (LibreOffice/OCR); the other AI calls use 30 s (default 120000).
AI_SERVICE_PARSE_TIMEOUT_MS=120000
BACKGROUND_JOBS_ENABLED=true
# Scheduled tasks: close PUBLISHED jobs past their deadline; expire overdue work samples; send the mail outbox
JOB_DEADLINE_CLOSER_ENABLED=true
WORK_SAMPLE_EXPIRY_SWEEP_ENABLED=true
NOTIFICATIONS_SENDER_ENABLED=true

# ---- Resume storage ----
FILE_STORAGE_PATH=./uploads

# ---- Verification (Claim Ledger, WP-VBE) ----
# Agent service (agent-service/, port 8100); the token must equal its AGENT_SERVICE_TOKEN
AGENT_SERVICE_URL=http://localhost:8100
AGENT_SERVICE_TOKEN=replace-with-the-same-random-secret-used-by-agent-service
# AES-256-GCM key, 32 random bytes Base64 (`openssl rand -base64 32`); without it GitHub OAuth (and MFA) answer 503
APP_ENCRYPTION_KEY=
# Optional GitHub OAuth app (scope read:user); register <backend>/api/v1/verification/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/verification/oauth/github/callback
# Evidence snapshots and uploaded verification documents (default: $FILE_STORAGE_PATH/verification)
VERIFICATION_STORAGE_PATH=./uploads/verification
# Expire unanswered reference requests after 14 days
VERIFICATION_REFERENCE_EXPIRY_ENABLED=true

# ---- Data retention (WP-OPS) ----
# Daily purge of used/expired tokens and login states, finished jobs, delivered notifications, old rate-limit
# windows and audit events; old ended reference requests lose the referee's details. Periods: app.retention.* in
# application.yml. RETENTION_AUDIT_DAYS=0 keeps audit events forever.
RETENTION_ENABLED=true
RETENTION_CRON="0 30 3 * * *"
RETENTION_AUDIT_DAYS=730

# ---- Email (Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit) ----
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=RecruitPro <no-reply@recruitpro.local>
# dev: log verification/reset/invitation links (with tokens) when MAIL_ENABLED=false
NOTIFICATIONS_LOG_LINKS=true
# dev: return the invitation link in POST /api/v1/admin/invitations
INVITATIONS_EXPOSE_LINK=true

# ---- First organisation (created once when none exists) ----
BOOTSTRAP_ORG_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Organisation
BOOTSTRAP_ADMIN_LAST_NAME=Admin

# ---- Demo data (never in prod) ----
APP_SEED_DEMO=false
APP_SEED_PASSWORD=ChangeMe-123!

# ---- Platform hardening (WP-PLAT) ----
# Rate-limit counters: memory (single instance) or database (shared table rate_limit_buckets, several instances)
RATE_LIMIT_STORE=memory
# Id of this instance in notification row claims (default: host name + random suffix)
APP_INSTANCE_ID=
# Issuer label shown in authenticator apps (staff TOTP MFA needs APP_ENCRYPTION_KEY above)
MFA_ISSUER=RecruitPro
# Staff SSO (OIDC). Register <SSO_REDIRECT_BASE_URL>/api/v1/auth/sso/<google|microsoft|oidc>/callback with the IdP.
# A provider is offered only when its client id and secret are set (and APP_ENCRYPTION_KEY is set).
SSO_REDIRECT_BASE_URL=http://localhost:8080
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
# Your Entra tenant id (recommended) or "organizations"
SSO_MICROSOFT_TENANT_ID=organizations
SSO_OIDC_NAME=Company SSO
SSO_OIDC_CLIENT_ID=
SSO_OIDC_CLIENT_SECRET=
SSO_OIDC_ISSUER=
# Scopes requested from the generic OIDC provider (default "openid email profile")
SSO_OIDC_SCOPES="openid email profile"
# /actuator/prometheus without authentication (only behind a private network); otherwise ADMIN only
METRICS_PUBLIC=false
# Work-sample submission files (default: $FILE_STORAGE_PATH/work-samples)
WORK_SAMPLE_STORAGE_PATH=./uploads/work-samples
